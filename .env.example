# CommitStreak Environment Variables Example
# Copy this file to .env for local development

# GitHub OAuth Application Credentials
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Default monitored GitHub username
VITE_DEFAULT_GITHUB_USERNAME=torvalds

# Application URL (used for OAuth redirect callbacks)
# In production on Vercel, this will be your vercel domain e.g. https://commitstreak.vercel.app
APP_URL=http://localhost:5173

# Optional: Personal Access Token (for extended GitHub REST API rate limits)
GITHUB_PAT=

# Optional: Database connection for persistent multi-user journal
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
